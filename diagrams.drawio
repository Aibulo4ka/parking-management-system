        <mxCell id="t3_1" value="SELECT бронирования:&#xa;status IN (pending, confirmed)&#xa;AND reminder_sent_at IS NULL&#xa;AND start_time BETWEEN now()&#xa;  AND now() + 30 минут&#xa;AND telegram_chat_id IS NOT NULL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
